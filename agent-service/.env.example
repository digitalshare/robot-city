# Copy to .env for the agent service. Never commit real credentials.
COGNEE_BASE_URL=https://your-tenant.cognee.cloud
COGNEE_API_KEY=
# Dataset is fixed by the application; this variable is not used.
COGNEE_DATASET=robot-city

# Strands model provider; configure according to the selected provider.
# Example for an OpenAI-compatible provider:
ROBOT_AGENT_MODEL=
OPENAI_API_KEY=

# Optional service bind settings
ROBOT_AGENT_HOST=127.0.0.1
ROBOT_AGENT_PORT=8787
